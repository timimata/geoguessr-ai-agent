# Credential and endpoint. Any OpenAI-compatible endpoint works; the default
# points at Google's Gemini compatibility layer. A local LM Studio server is
# http://localhost:1234/v1 with any non-empty key.
GEMINI_API_KEY=
OPENAI_BASE_URL=

# Model to use. MODEL_IDS takes a comma-separated list that the bot rotates
# through round by round, so two models see the same stream of locations.
MODEL_ID=
MODEL_IDS=

# solo | duels | team-duels
MODE=

# --- optional -------------------------------------------------------------
# Pipeline features to switch off, comma-separated. Names are the keys of
# FEATURES in config.py. Use benchmark.py to decide, not intuition.
FEATURES_OFF=

# Retrieval encoder: openclip (default) or streetclip. Each keeps its own
# ChromaDB collections, so changing this means running indexador.py again.
RAG_EMBEDDING=

# Maximum embedding distance for a retrieved round to reach the prompt.
# Measure it with rag_calibrate.py; the right value differs per encoder.
RAG_DISTANCE_THRESHOLD=

# Write one annotated compass crop per round to compass_debug/. Debugging only.
COMPASS_DEBUG=

# Transport retries for the main model call, and the total seconds of backoff
# allowed in duels, where the round is on a clock.
MODEL_ATTEMPTS=
MODEL_RETRY_BUDGET_S=
